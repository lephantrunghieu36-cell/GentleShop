@model GentleShop.Models.User

@{
    ViewData["Title"] = "Cập nhật người dùng";
}

<div class="pd-ltr-20 xs-pd-20-10">
    <div class="min-height-200px">

        <div class="page-header">
            <div class="row">
                <div class="col-md-6 col-sm-12">
                    <div class="title">
                        <h4>Cập nhật người dùng</h4>
                    </div>

                    <nav aria-label="breadcrumb" role="navigation">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a asp-area="Admin"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Trang chủ
                                </a>
                            </li>

                            <li class="breadcrumb-item">
                                <a asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="Index">
                                    Người dùng
                                </a>
                            </li>

                            <li class="breadcrumb-item active" aria-current="page">
                                Cập nhật người dùng
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>

        <div class="pd-20 card-box mb-30">
            <div class="pd-20">
                <h4 class="text-blue h4">Thông tin người dùng</h4>
                <p class="mb-0">
                    Cập nhật thông tin tài khoản trong hệ thống GentleShop.
                </p>
            </div>

            <div class="pb-20">
                <form asp-area="Admin"
                      asp-controller="User"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Mã người dùng</label>
                                <input class="form-control"
                                       value="@Model.Id"
                                       readonly />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="FullName">
                                    Họ và tên <span class="text-danger">*</span>
                                </label>
                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Nhập họ và tên"
                                       required />
                                <span asp-validation-for="FullName"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Email">
                                    Email <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="example@email.com"
                                       required />
                                <span asp-validation-for="Email"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Phone">Số điện thoại</label>
                                <input asp-for="Phone"
                                       type="tel"
                                       class="form-control"
                                       placeholder="Nhập số điện thoại" />
                                <span asp-validation-for="Phone"
                                      class="text-danger"></span>
                            </div>
                        </div>


                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Role">
                                    Vai trò <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Role" class="form-control" required>
                                    <option value="STUDENT">Học sinh</option>
                                    <option value="TEACHER">Nhân viên</option>
                                    <option value="ADMIN">Quản trị viên</option>
                                </select>
                                <span asp-validation-for="Role"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Status">Trạng thái tài khoản</label>
                                <select asp-for="Status" class="form-control">
                                    <option value="true">Hoạt động</option>
                                    <option value="false">Ngừng hoạt động</option>
                                </select>
                                <span asp-validation-for="Status"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Ngày tạo</label>
                                <input class="form-control"
                                       value="@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")"
                                       readonly />
                            </div>
                        </div>

                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="dw dw-diskette1"></i> Lưu thay đổi
                    </button>

                    <a asp-area="Admin"
                       asp-controller="User"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

