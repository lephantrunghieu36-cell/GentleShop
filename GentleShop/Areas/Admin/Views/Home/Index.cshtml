@{
    ViewData["Title"] = "Trang quản trị";

    var userCount = 12;
    var subjectCount = 8;
    var classroomCount = 6;
    var quizCount = 24;
    var currentYear = DateTime.Now.Year;

    var monthlyQuizData = new[] { 8, 12, 10, 16, 14, 20, 18, 24, 21, 27, 30, 35 };
    var monthlyStudentData = new[] { 10, 12, 15, 18, 20, 22, 25, 28, 30, 32, 35, 40 };
}

<div class="xs-pd-20-10 pd-ltr-20">
    <div class="title pb-20">
        <h2 class="h3 mb-0">Trang Quản Trị Hệ Thống</h2>
        <p class="text-muted mt-2">Tổng quan hoạt động hệ thống Classroom360</p>
    </div>

    <div class="row pb-10">
        <div class="col-xl-3 col-lg-3 col-md-6 mb-20">
            <div class="card-box height-100-p widget-style3">
                <div class="d-flex flex-wrap">
                    <div class="widget-data">
                        <div class="weight-700 font-24 text-dark">@userCount</div>
                        <div class="font-14 text-secondary weight-500">Tổng tài khoản</div>
                    </div>
                    <div class="widget-icon">
                        <div class="icon" data-color="#00eccf">
                            <i class="icon-copy dw dw-user"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 mb-20">
            <div class="card-box height-100-p widget-style3">
                <div class="d-flex flex-wrap">
                    <div class="widget-data">
                        <div class="weight-700 font-24 text-dark">@subjectCount</div>
                        <div class="font-14 text-secondary weight-500">Môn học</div>
                    </div>
                    <div class="widget-icon">
                        <div class="icon" data-color="#ff5b5b">
                            <i class="icon-copy dw dw-book"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 mb-20">
            <div class="card-box height-100-p widget-style3">
                <div class="d-flex flex-wrap">
                    <div class="widget-data">
                        <div class="weight-700 font-24 text-dark">@classroomCount</div>
                        <div class="font-14 text-secondary weight-500">Lớp học</div>
                    </div>
                    <div class="widget-icon">
                        <div class="icon" data-color="#09cc06">
                            <i class="icon-copy dw dw-building"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 mb-20">
            <div class="card-box height-100-p widget-style3">
                <div class="d-flex flex-wrap">
                    <div class="widget-data">
                        <div class="weight-700 font-24 text-success">@quizCount</div>
                        <div class="font-14 text-secondary weight-500">Bài kiểm tra</div>
                    </div>
                    <div class="widget-icon">
                        <div class="icon" data-color="#28a745">
                            <i class="icon-copy dw dw-edit"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-box mb-30 mt-4">
        <div class="pd-20">
            <h4 class="text-blue h4">Thống kê bài kiểm tra năm @currentYear</h4>
            <p class="text-muted">Số bài kiểm tra được tạo theo từng tháng</p>
        </div>
        <div class="pb-20 px-3">
            <canvas id="quizChart" style="width: 100%; height: 350px;"></canvas>
        </div>
    </div>

    <div class="card-box mb-30 mt-4">
        <div class="pd-20">
            <h4 class="text-success h4">Thống kê học viên năm @currentYear</h4>
            <p class="text-muted">Số học viên minh họa theo từng tháng</p>
        </div>
        <div class="pb-20 px-3">
            <canvas id="studentChart" style="width: 100%; height: 350px;"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const monthLabels = [
        "Th1", "Th2", "Th3", "Th4", "Th5", "Th6",
        "Th7", "Th8", "Th9", "Th10", "Th11", "Th12"
    ];

    const quizData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyQuizData));
    const studentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyStudentData));

    new Chart(document.getElementById("quizChart"), {
        type: "line",
        data: {
            labels: monthLabels,
            datasets: [{
                label: "Số bài kiểm tra",
                data: quizData,
                borderColor: "#007bff",
                backgroundColor: "rgba(0,123,255,0.15)",
                borderWidth: 3,
                fill: true,
                tension: 0.35
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { precision: 0 }
                }
            }
        }
    });

    new Chart(document.getElementById("studentChart"), {
        type: "line",
        data: {
            labels: monthLabels,
            datasets: [{
                label: "Số học viên minh họa",
                data: studentData,
                borderColor: "#28a745",
                backgroundColor: "rgba(40,167,69,0.15)",
                borderWidth: 3,
                fill: true,
                tension: 0.35
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { precision: 0 }
                }
            }
        }
    });
</script>