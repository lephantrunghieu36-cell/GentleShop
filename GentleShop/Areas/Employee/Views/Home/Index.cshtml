@{
    ViewData["Title"] = "Trang quản trị GentleShop";

    var userCount = 1240;
    var productCount = 48;
    var orderCount = 156;
    var revenueTotal = "1.850.000.000₫";
    var currentYear = DateTime.Now.Year;

    var monthlyRevenueData = new[]
    {
        150, 220, 190, 280, 250, 360,
        310, 420, 390, 520, 590, 680
    };

    var monthlyProductData = new[]
    {
        12, 18, 15, 22, 20, 28,
        25, 34, 30, 42, 48, 55
    };
}

<div class="xs-pd-20-10 pd-ltr-20">

    <div class="title pb-20">
        <h2 class="h3 mb-0">Tổng Quan Hệ Thống GentleShop</h2>
        <p class="text-muted mt-2">
            Theo dõi hoạt động kinh doanh, sản phẩm và đơn hàng của cửa hàng laptop
        </p>
    </div>

    <div class="row pb-10">

        <div class="col-xl-3 col-lg-3 col-md-6 mb-20">
            <div class="card-box height-100-p widget-style3">
                <div class="d-flex flex-wrap">
                    <div class="widget-data">
                        <div class="weight-700 font-24 text-dark">
                            @userCount.ToString("N0")
                        </div>
                        <div class="font-14 text-secondary weight-500">
                            Tổng tài khoản
                        </div>
                    </div>
                    <div class="widget-icon">
                        <div class="icon" data-color="#00eccf">
                            <i class="icon-copy dw dw-user"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 mb-20">
            <div class="card-box height-100-p widget-style3">
                <div class="d-flex flex-wrap">
                    <div class="widget-data">
                        <div class="weight-700 font-24 text-dark">
                            @productCount
                        </div>
                        <div class="font-14 text-secondary weight-500">
                            Sản phẩm
                        </div>
                    </div>
                    <div class="widget-icon">
                        <div class="icon" data-color="#ff5b5b">
                            <i class="icon-copy dw dw-laptop"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 mb-20">
            <div class="card-box height-100-p widget-style3">
                <div class="d-flex flex-wrap">
                    <div class="widget-data">
                        <div class="weight-700 font-24 text-dark">
                            @orderCount
                        </div>
                        <div class="font-14 text-secondary weight-500">
                            Tổng đơn hàng
                        </div>
                    </div>
                    <div class="widget-icon">
                        <div class="icon" data-color="#09cc06">
                            <i class="icon-copy dw dw-shopping-cart"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 mb-20">
            <div class="card-box height-100-p widget-style3">
                <div class="d-flex flex-wrap">
                    <div class="widget-data">
                        <div class="weight-700 font-22 text-success">
                            @revenueTotal
                        </div>
                        <div class="font-14 text-secondary weight-500">
                            Tổng doanh thu
                        </div>
                    </div>
                    <div class="widget-icon">
                        <div class="icon" data-color="#28a745">
                            <i class="icon-copy dw dw-money"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card-box mb-30 mt-4">
        <div class="pd-20">
            <h4 class="text-blue h4">
                Thống kê doanh thu năm @currentYear
            </h4>
            <p class="text-muted">
                Doanh thu bán laptop theo từng tháng (triệu VNĐ)
            </p>
        </div>

        <div class="pb-20 px-3">
            <div style="position: relative; height: 350px; width: 100%;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="card-box mb-30 mt-4">
        <div class="pd-20">
            <h4 class="text-success h4">
                Thống kê sản phẩm bán ra năm @currentYear
            </h4>
            <p class="text-muted">
                Số lượng laptop được bán theo từng tháng
            </p>
        </div>

        <div class="pb-20 px-3">
            <div style="position: relative; height: 350px; width: 100%;">
                <canvas id="productChart"></canvas>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const monthLabels = [
        "Th1", "Th2", "Th3", "Th4", "Th5", "Th6",
        "Th7", "Th8", "Th9", "Th10", "Th11", "Th12"
    ];

    const revenueData = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(monthlyRevenueData)
                );

    const productData = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(monthlyProductData)
                );

    new Chart(document.getElementById("revenueChart"), {
        type: "line",
        data: {
            labels: monthLabels,
            datasets: [{
                label: "Doanh thu (triệu VNĐ)",
                data: revenueData,
                borderColor: "#007bff",
                backgroundColor: "rgba(0,123,255,0.15)",
                borderWidth: 3,
                fill: true,
                tension: 0.35,
                pointRadius: 4,
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: "top"
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return "Doanh thu: " +
                                context.parsed.y.toLocaleString("vi-VN") +
                                " triệu VNĐ";
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { precision: 0 }
                }
            }
        }
    });

    new Chart(document.getElementById("productChart"), {
        type: "bar",
        data: {
            labels: monthLabels,
            datasets: [{
                label: "Số lượng laptop bán ra",
                data: productData,
                backgroundColor: "rgba(40,167,69,0.7)",
                borderColor: "#28a745",
                borderWidth: 1,
                borderRadius: 5,
                maxBarThickness: 35
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: "top"
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { precision: 0 }
                }
            }
        }
    });
</script>
