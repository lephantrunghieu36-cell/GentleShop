@model GentleShop.Models.Category

@{
    ViewData["Title"] = "Cập nhật danh mục";
}

<div class="pd-ltr-20 xs-pd-20-10">
    <div class="min-height-200px">

        <div class="page-header">
            <div class="row">
                <div class="col-md-6 col-sm-12">
                    <div class="title">
                        <h4>Cập nhật danh mục</h4>
                    </div>

                    <nav aria-label="breadcrumb" role="navigation">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a asp-area="Employee"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Trang chủ
                                </a>
                            </li>

                            <li class="breadcrumb-item">
                                <a asp-area="Employee"
                                   asp-controller="Category"
                                   asp-action="Index">
                                    Danh mục
                                </a>
                            </li>

                            <li class="breadcrumb-item active" aria-current="page">
                                Cập nhật danh mục
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>

        <div class="pd-20 card-box mb-30">
            <div class="pd-20">
                <h4 class="text-blue h4">Thông tin danh mục</h4>
                <p class="mb-0">
                    Cập nhật thông tin danh mục trong hệ thống GentleShop.
                </p>
            </div>

            <div class="pb-20">
                <form asp-area="Employee"
                      asp-controller="Category"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Name">
                                    Tên danh mục <span class="text-danger">*</span>
                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Nhập tên danh mục"
                                       required />

                                <span asp-validation-for="Name"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="Description">Mô tả</label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Nhập mô tả danh mục"></textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="dw dw-diskette1"></i> Lưu thay đổi
                    </button>

                    <a asp-area="Employee"
                       asp-controller="Category"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>

                </form>
            </div>
        </div>
    </div>
</div>
